# Consumer sign-in: public configuration only. Install the identity hook in docs/consumer-auth.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional administrator console configuration (not required for consumer features).
SUPERUSER_EMAILS=you@example.com
VOX_ADMIN_ORIGIN=https://admin.voxagent.in
VOX_CORE_ADMIN_URL=http://127.0.0.1:3001
VOX_ADMIN_TOKEN=
# Consumer app features (reminders, tasks, apps, privacy, connected accounts) call Vox Core.
# The three host values come from registering this app: POST /v1/host-apps on Core.
VOX_CORE_URL=https://api.voxagent.in
VOX_HOST_CREDENTIAL_ID=
VOX_HOST_AUDIENCE=
VOX_HOST_SECRET=
# Exact public Web callback; must also be allowed in Core VOX_MCP_OAUTH_REDIRECT_URIS.
VOX_CONNECTED_APPS_REDIRECT_URI=https://app.voxagent.in/apps/oauth/callback
